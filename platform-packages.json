{
  "version": 1,
  "description": "Grafo de dependências entre os pacotes da plataforma (ADR 004). O Kit é folha; Design System também é independente e tem distribuição visual versionada. Produtos consomem releases imutáveis.",
  "packages": {
    "kit": {
      "path": "packages/kit",
      "depends_on": []
    },
    "harness": {
      "path": "packages/harness",
      "depends_on": [
        "kit"
      ],
      "python_modules": [
        "product_platform_harness"
      ],
      "distributions": [
        "@leandroclf/product-platform-harness",
        "product-platform-harness"
      ]
    },
    "cli": {
      "path": "packages/cli",
      "depends_on": [
        "kit"
      ],
      "python_modules": [
        "omnicli"
      ],
      "distributions": [
        "omnicli"
      ]
    },
    "engineering-team": {
      "path": "packages/engineering-team",
      "depends_on": [
        "kit"
      ]
    },
    "design-system": {
      "path": "packages/design-system",
      "depends_on": [],
      "python_modules": [],
      "distributions": [
        "@lf-solucoes/design-system"
      ]
    }
  }
}
