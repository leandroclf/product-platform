[Unit]
Description=Revisão independente de PR R1 opt-in da Product Platform
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/product-platform-reviewer/runtime
EnvironmentFile=%h/.config/product-platform-reviewer/reviewer.env
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/%U/bus
ExecStart=/usr/bin/python3 scripts/independent_pr_reviewer.py
TimeoutStartSec=20min
UMask=0077
Nice=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/state/product-platform-reviewer
