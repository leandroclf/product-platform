{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PortfolioCapabilityHandoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["registry_fingerprint", "product", "capabilities"],
  "properties": {
    "registry_fingerprint": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "product": {"type": "string", "minLength": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "decision", "owner"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "decision": {"enum": ["REUSE", "EXTEND", "CREATE"]},
          "owner": {"type": "string", "minLength": 1},
          "version": {"type": ["string", "null"]},
          "reason": {"type": ["string", "null"]}
        }
      }
    }
  }
}