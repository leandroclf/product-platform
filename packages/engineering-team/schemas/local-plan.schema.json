{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "type": "string"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "READY",
        "BLOCKED"
      ]
    },
    "risk": {
      "type": "string",
      "enum": [
        "R0",
        "R1",
        "R2",
        "R3"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "out_of_scope": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "acceptance_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 40,
            "items": {
              "type": "string",
              "pattern": "^AC[0-9]+$"
            }
          }
        },
        "required": [
          "id",
          "description",
          "acceptance_ids"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^AC[0-9]+$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          }
        },
        "required": [
          "id",
          "description"
        ]
      }
    },
    "validation": {
      "type": "array",
      "maxItems": 40,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      }
    }
  },
  "required": [
    "schema_version",
    "base_sha",
    "status",
    "risk",
    "objective",
    "out_of_scope",
    "assumptions",
    "tasks",
    "acceptance_criteria",
    "validation"
  ]
}
