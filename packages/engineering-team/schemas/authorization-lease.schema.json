{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ai-engineering-team:authorization-lease:1.0.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scope_id",
    "task_id",
    "project_id",
    "revision",
    "repository",
    "issued_at",
    "expires_at",
    "allowed_actions",
    "denied_actions",
    "allowed_paths"
  ],
  "properties": {
    "scope_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "branch",
        "base_sha"
      ],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 1
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "base_sha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "allowed_actions": {
      "type": "array",
      "items": {
        "enum": [
          "read_repo",
          "modify_branch",
          "run_tests",
          "create_commit",
          "create_pr"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "denied_actions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "allowed_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    }
  }
}
