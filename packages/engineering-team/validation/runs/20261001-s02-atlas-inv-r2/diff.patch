+    def test_delete_item(self):
+        _, item = app.handle("POST", "/items", json.dumps({"name": "pen"}))
+        path = f"/items/{item['id']}"
+        self.assertEqual(app.handle("DELETE", path), (204, None))
+        self.assertEqual(app.handle("GET", path), (404, {"error": "not found"}))
+        self.assertEqual(app.handle("GET", "/items"), (200, []))
+        self.assertEqual(app.handle("DELETE", path), (404, {"error": "not found"}))
+
+    def test_delete_missing_item(self):
+        self.assertEqual(app.handle("DELETE", "/items/missing"),
+                         (404, {"error": "not found"}))
+
+    def test_create_after_delete_preserves_other_items(self):
+        _, first = app.handle("POST", "/items", json.dumps({"name": "pen"}))
+        _, second = app.handle("POST", "/items", json.dumps({"name": "pencil"}))
+        self.assertEqual(app.handle("DELETE", f"/items/{first['id']}"), (204, None))
+        _, third = app.handle("POST", "/items", json.dumps({"name": "paper"}))
+        self.assertNotEqual(second["id"], third["id"])
+        self.assertEqual(app.handle("GET", f"/items/{second['id']}"), (200, second))
+        self.assertEqual(app.handle("GET", "/items"), (200, [second, third]))
+
+    def test_delete_requires_item_path(self):
+        self.assertEqual(app.handle("DELETE", "/items")[0], 405)
