         self.assertEqual(app.handle("POST", "/items", "{}")[0], 400)
 
+    def test_delete_item(self):
+        _, item = app.handle("POST", "/items", json.dumps({"name": "pen"}))
+        _, other = app.handle("POST", "/items", json.dumps({"name": "book"}))
+        path = f"/items/{item['id']}"
+
+        self.assertEqual(app.handle("DELETE", path), (204, None))
+        self.assertNotIn(item["id"], app.ITEMS)
+        self.assertEqual(app.handle("GET", path), (404, {"error": "not found"}))
+        self.assertEqual(app.handle("GET", "/items"), (200, [other]))
+        self.assertEqual(app.handle("DELETE", path), (404, {"error": "not found"}))
+
+    def test_delete_missing_item(self):
+        self.assertEqual(
+            app.handle("DELETE", "/items/missing"),
+            (404, {"error": "not found"}),
+        )
+        self.assertEqual(app.ITEMS, {})
+
+    def test_delete_requires_item_path(self):
+        _, item = app.handle("POST", "/items", json.dumps({"name": "pen"}))
+        for path in ("/items", f"/items/{item['id']}/extra"):
+            with self.subTest(path=path):
+                self.assertEqual(
+                    app.handle("DELETE", path),
+                    (405, {"error": "method not allowed"}),
+                )
+        self.assertEqual(app.handle("GET", "/items"), (200, [item]))
