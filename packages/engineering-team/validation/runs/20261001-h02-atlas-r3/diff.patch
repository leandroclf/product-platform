+import unittest
+
+from paginate import page
+
+
+class PaginationTest(unittest.TestCase):
+    def test_one_based_pages(self):
+        items = [1, 2, 3, 4, 5]
+        for number, expected in [(1, [1, 2]), (2, [3, 4]), (3, [5]), (4, [])]:
+            with self.subTest(number=number):
+                self.assertEqual(page(items, number, 2), expected)
+        self.assertEqual(items, [1, 2, 3, 4, 5])
+
+    def test_empty_items(self):
+        self.assertEqual(page([], 1, 2), [])
+
+    def test_page_larger_than_items(self):
+        self.assertEqual(page([1, 2, 3], 1, 5), [1, 2, 3])
+
+
+if __name__ == "__main__":
+    unittest.main()
