@@ -0,0 +1,22 @@
+import unittest
+
+from sample import is_authorized
+
+
+class AuthorizationTests(unittest.TestCase):
+    def test_admin_is_authorized(self):
+        self.assertIs(is_authorized("admin"), True)
+
+    def test_other_roles_are_denied(self):
+        for role in ("user", "guest", "viewer", "superadmin", "", "ADMIN", "Admin", " admin", "admin "):
+            with self.subTest(role=role):
+                self.assertIs(is_authorized(role), False)
+
+    def test_non_string_inputs_are_denied(self):
+        for role in (None, False, True, 0, 1, [], {}, ["admin"]):
+            with self.subTest(role=role):
+                self.assertIs(is_authorized(role), False)
+
+
+if __name__ == "__main__":
+    unittest.main()
