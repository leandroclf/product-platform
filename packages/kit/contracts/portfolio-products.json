  "historical_products": [],
  "policy": {
    "product_source_dependencies": false,
    "external_telemetry_default": "off",
    "adoption": "capability-by-capability"
  },
  "platform_monorepo": {
    "repository": "product-platform",
    "dependency_graph": "platform-packages.json",
    "packages": {
      "product-platform-kit": "packages/kit",
      "product-platform-harness": "packages/harness",
      "product-platform-cli": "packages/cli",
      "product-platform-engineering-team": "packages/engineering-team"
    }
  },
  "portal": {
    "repository": "site-lf-solucoes",
    "website": "https://lfsolucoes.etc.br/",
    "catalog_manifest": "data/product-catalog.json",
    "catalog_route": "/produtos/",
    "required_for_new_products": true,
    "publication_requires_editorial_review": true,
    "automatic_cross_repo_sync_verified": false
  }
}
