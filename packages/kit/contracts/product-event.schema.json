{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portfolio Product Event",
  "type": "object",
  "additionalProperties": true,
  "required": ["event", "product_id", "environment", "release_sha", "occurred_at"],
  "properties": {
    "event": { "enum": ["signup_completed", "activation_completed", "feature_used", "limit_reached", "upgrade_intent", "subscription_changed", "feedback_submitted"] },
    "product_id": { "type": "string", "minLength": 1 },
    "environment": { "type": "string", "minLength": 1 },
    "release_sha": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "user_id": { "type": ["string", "null"] },
    "account_id": { "type": ["string", "null"] },
    "plan_id": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "feature": { "type": ["string", "null"] },
    "outcome": { "type": ["string", "null"] }
  }
}