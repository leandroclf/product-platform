{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlatformHandoff",
  "description": "Envelope entregue pelo product-platform-cli ao product-platform-engineering-team: proposta, resolução de capacidades e regras aplicáveis. O kit é o dono do contrato; os schemas de proposta e de capacidades dos demais repositórios são subconjuntos deste.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "proposal", "portfolio", "rules_refs"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["proposal_id", "repository", "objective", "scope", "acceptance", "risk", "evidence"],
      "properties": {
        "proposal_id": {"type": "string", "minLength": 1},
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "base_ref"],
          "properties": {
            "url": {"type": "string", "minLength": 1},
            "base_ref": {"type": "string", "minLength": 1},
            "base_sha": {"$ref": "#/$defs/sha1"}
          }
        },
        "objective": {"type": "string", "minLength": 1},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowed_paths"],
          "properties": {"allowed_paths": {"type": "array", "items": {"type": "string", "minLength": 1}}}
        },
        "acceptance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["criteria"],
          "properties": {"criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}
        },
        "risk": {
          "type": "object",
          "additionalProperties": false,
          "required": ["level"],
          "properties": {"level": {"enum": ["low", "medium", "high", "critical"]}}
        },
        "evidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["required"],
          "properties": {"required": {"type": "array", "items": {"enum": ["tests", "build", "ci", "security", "benchmark"]}}}
        }
      }
    },
    "portfolio": {"$ref": "#/$defs/portfolio"},
    "rules_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kit", "harness", "profile"],
      "properties": {
        "kit": {"$ref": "#/$defs/pinned"},
        "harness": {"$ref": "#/$defs/pinned"},
        "profile": {"enum": ["core", "backend", "frontend", "devops", "security"]}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "pinned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref"],
      "properties": {
        "ref": {"$ref": "#/$defs/sha1", "description": "SHA completo do commit; nunca branch ou tag flutuante."},
        "artifact_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "portfolio": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_fingerprint", "product", "capabilities"],
      "properties": {
        "registry_fingerprint": {"$ref": "#/$defs/sha256"},
        "product": {"type": "string", "minLength": 1},
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "decision", "owner"],
            "properties": {
              "name": {"type": "string", "minLength": 1},
              "decision": {"enum": ["REUSE", "EXTEND", "CREATE"]},
              "owner": {"type": "string", "minLength": 1},
              "version": {"type": ["string", "null"]},
              "reason": {"type": ["string", "null"]}
            }
          }
        }
      }
    }
  }
}
