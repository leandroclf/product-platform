{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leandroclf/product-platform/visual-feedback/task/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "usage": {
          "enum": [
            "owned",
            "authorized",
            "synthetic"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "artifact",
        "usage",
        "source"
      ]
    },
    "design_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "viewports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 3840
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 2160
          }
        },
        "required": [
          "id",
          "width",
          "height"
        ]
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "visual",
              "functional",
              "accessibility"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "kind",
          "description"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "unknown_cost_policy": {
          "const": "stop"
        }
      },
      "required": [
        "max_iterations",
        "max_elapsed_seconds",
        "max_cost_usd",
        "unknown_cost_policy"
      ]
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "base_sha",
    "reference",
    "design_system",
    "viewports",
    "criteria",
    "budget"
  ]
}
