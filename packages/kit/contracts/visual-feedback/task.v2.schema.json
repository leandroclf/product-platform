{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leandroclf/product-platform/visual-feedback/task/v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "usage": {
          "enum": [
            "owned",
            "authorized",
            "synthetic"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "artifact",
        "usage",
        "source"
      ]
    },
    "design_system": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "viewports": {
      "type": "array",
      "minItems": 2,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "width": {
            "type": "integer",
            "minimum": 240,
            "maximum": 3840
          },
          "height": {
            "type": "integer",
            "minimum": 240,
            "maximum": 2160
          }
        },
        "required": [
          "id",
          "width",
          "height"
        ]
      }
    },
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "kind": {
            "enum": [
              "visual",
              "functional",
              "accessibility"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "kind",
          "description"
        ]
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_iterations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "max_elapsed_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_cost_usd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "unknown_cost_policy": {
          "const": "stop"
        }
      },
      "required": [
        "max_iterations",
        "max_elapsed_seconds",
        "max_cost_usd",
        "unknown_cost_policy"
      ]
    },
    "ux": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "user_goal": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "entry": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "exit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "patterns_status": {
          "enum": [
            "existing",
            "new",
            "not-assessed"
          ]
        },
        "pattern_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 0,
          "maxItems": 100
        },
        "design_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "minItems": 1,
          "maxItems": 100
        },
        "states": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "ready",
                  "loading",
                  "empty",
                  "error",
                  "disabled"
                ]
              },
              "applicable": {
                "type": "boolean"
              },
              "behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "applicable",
              "behavior"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "user_goal",
        "entry",
        "exit",
        "patterns_status",
        "pattern_refs",
        "design_constraints",
        "states"
      ]
    },
    "impact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "minItems": 1,
          "maxItems": 100
        },
        "preserved_behaviors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "behavior": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            },
            "required": [
              "id",
              "behavior"
            ]
          },
          "minItems": 1,
          "maxItems": 100
        }
      },
      "required": [
        "paths",
        "preserved_behaviors"
      ]
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "behavior_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "criterion_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            },
            "minItems": 1,
            "maxItems": 100,
            "uniqueItems": true
          },
          "check_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "id",
          "behavior_ids",
          "criterion_ids",
          "check_name"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "performance_budgets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "baseline": {
            "type": "number",
            "minimum": 0
          },
          "max_after": {
            "type": "number",
            "minimum": 0
          }
        },
        "required": [
          "id",
          "unit",
          "baseline",
          "max_after"
        ]
      },
      "minItems": 0,
      "maxItems": 100
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "repository",
    "base_sha",
    "reference",
    "design_system",
    "viewports",
    "criteria",
    "budget",
    "ux",
    "impact",
    "regressions",
    "performance_budgets"
  ]
}
