{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leandroclf/product-platform/visual-feedback/evidence/v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "condition": {
      "enum": [
        "baseline",
        "visual-feedback"
      ]
    },
    "status": {
      "enum": [
        "captured",
        "assessed",
        "blocked"
      ]
    },
    "iterations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "cost_usd": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "model_execution": {
      "enum": [
        "not-run",
        "live"
      ]
    },
    "screenshots": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "viewport_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "artifact": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "path",
              "sha256"
            ]
          }
        },
        "required": [
          "viewport_id",
          "artifact"
        ]
      }
    },
    "checks": {
      "type": "array",
      "minItems": 0,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "criterion_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "pass",
              "fail",
              "not-run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "required": [
          "criterion_id",
          "status",
          "evidence"
        ]
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2000
      }
    }
  },
  "required": [
    "schema_version",
    "task_sha256",
    "head_sha",
    "condition",
    "status",
    "iterations",
    "elapsed_seconds",
    "cost_usd",
    "model_execution",
    "screenshots",
    "checks",
    "limitations"
  ]
}
